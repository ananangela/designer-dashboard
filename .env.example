# Google Sheets API 設定
# 1. 本地開發: 將 credentials.json 放在此目錄，使用 OAuth token.pickle
# 2. 雲端部署: 使用 Service Account JSON (下方)

# Service Account JSON (雲端部署用，注意需要完整的 JSON 字符串)
# 從 Google Cloud Console 下載 Service Account JSON，
# 將內容轉換為單行字符串後設定為環境變數
# GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","...":"..."}'

# 或者直接使用環境變數讀取檔案路徑
# SERVICE_ACCOUNT_JSON_PATH=/path/to/service-account.json

# Google Sheets ID (保持預設或替換為其他 Sheet)
SHEET_ID=1K3VVKGJn47UTxGy7UGQtnkrO5yDVR9Bp7fHjMDVkv7w

# Flask 設定
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000
